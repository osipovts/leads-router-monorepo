{
  "compilerOptions": {
    "module": "commonjs",

    "target": "ES2022",

    "declaration": true,
    "sourceMap": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "isolatedModules": true,

    "incremental": true,

    "strict": true,
    "strictNullChecks": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  }
}
