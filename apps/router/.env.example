DATABASE_URL=postgresql://postgres:postgres@postgres:5432/leads?schema=public

BULLMQ_CONNECTION_HOST=redis
BULLMQ_CONNECTION_PORT=6379
BULLMQ_CONNECTION_PASSWORD=password

# Число одновременно обрабатываемых задач; по умолчанию 1.
LEADS_WORKER_CONCURRENCY=1
# Файл пульса для healthcheck контейнера: обновляется каждые 10 с, пока воркер подключён к Redis
# LEADS_WORKER_HEARTBEAT_FILE=/tmp/router-heartbeat

# console adapter
# Только для отладки: канал пишет полные данные лида (включая contact и message) в логи контейнера
CONSOLE_LEAD_DELIVERY_ENABLED=false

# database adapter
DATABASE_LEAD_DELIVERY_ENABLED=true
# Таймауты pg-пула в миллисекундах; дефолты 10000 и 15000
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_STATEMENT_TIMEOUT=15000

# telegram adapter
TELEGRAM_LEAD_DELIVERY_ENABLED=true
TELEGRAM_LEAD_DELIVERY_CHAT_ID=123456789
TELEGRAM_CLIENT_TOKEN=1234567890:AAAAABCDEFGHIJKLMNOPQRSTUVWXYZ123

# http adapter
HTTP_LEAD_DELIVERY_ENABLED=true
HTTP_LEAD_DELIVERY_ENDPOINTS=http://localhost:3050/leads
HTTP_CLIENT_TIMEOUT=1000
# Редиректы не отслеживаются: 3xx считается permanent-ошибкой доставки.
# Клиентские ретраи отключены: единственный слой повторов — LEADS_QUEUE_ATTEMPTS в gateway

# email adapter
EMAIL_LEAD_DELIVERY_ENABLED=false
EMAIL_LEAD_DELIVERY_TO=inbox@example.com
EMAIL_CLIENT_HOST=smtp.example.com
EMAIL_CLIENT_PORT=587 # 587 -> EMAIL_CLIENT_SECURE=false (STARTTLS), 465 -> true (implicit TLS)
EMAIL_CLIENT_SECURE=false
# При SECURE=false соединение без STARTTLS отклоняется; false разрешает открытую передачу (только для локального SMTP)
# EMAIL_CLIENT_REQUIRE_TLS=true
EMAIL_CLIENT_USER=leads@example.com
EMAIL_CLIENT_PASSWORD=app-password
EMAIL_CLIENT_FROM=leads@example.com
# Таймауты SMTP в миллисекундах; дефолты 10000, 10000 и 30000
EMAIL_CLIENT_CONNECTION_TIMEOUT=10000
EMAIL_CLIENT_GREETING_TIMEOUT=10000
EMAIL_CLIENT_SOCKET_TIMEOUT=30000
