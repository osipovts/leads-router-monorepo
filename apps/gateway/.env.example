APP_HOST=0.0.0.0
APP_PORT=3000
# Уровень логов приложения: debug | verbose | log | warn | error (по умолчанию log;
# debug включает request/response-логи интерцептора)
APP_LOGGER_LEVEL=log
# Число reverse-proxy перед gateway (в docker-compose это nginx фронтенда).
# Без этого rate limiter видит IP прокси, и все клиенты делят один лимит
APP_TRUST_PROXY_HOPS=1
APP_SWAGGER_ENABLE=false
# Пути вне /api: nginx фронтенда не проксирует их наружу
APP_SWAGGER_API_DOCS=docs
APP_SWAGGER_API_JSON_DOCS=json-docs

# Rate limiting (defaults: 60000 / 100)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

BULLMQ_CONNECTION_HOST=redis
BULLMQ_CONNECTION_PORT=6379
BULLMQ_CONNECTION_PASSWORD=password

# Число попыток доставки задачи, включая первую; задержка между попытками фиксированная, в мс.
# Если получатель просит подождать дольше (Telegram 429 retry_after), router ждёт столько, сколько он попросил.
# LEADS_QUEUE_ATTEMPTS=3
# LEADS_QUEUE_BACKOFF=5000
# При потере Redis gateway не сохраняет команды в локальную очередь; таймаут команды — 5 секунд.

# Срок хранения завершённых и неудачных задач в Redis (по умолчанию 1 час / 30 дней)
# LEADS_QUEUE_COMPLETED_RETENTION_MS=3600000
# LEADS_QUEUE_FAILED_RETENTION_MS=2592000000

# Окно дедупликации задач по id лида и каналу (по умолчанию 24 часа)
# LEADS_DEDUPLICATION_TTL_MS=86400000
