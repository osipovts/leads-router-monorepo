APP_HOST=0.0.0.0
APP_PORT=3000
# Число reverse-proxy перед gateway (в docker-compose это nginx фронтенда).
# Без этого rate limiter видит IP прокси, и все клиенты делят один лимит
APP_TRUST_PROXY_HOPS=1
APP_SWAGGER_ENABLE=false
APP_SWAGGER_API_DOCS=api/docs
APP_SWAGGER_API_JSON_DOCS=api/json-docs

# Rate limiting (defaults: 60000 / 100)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

BULLMQ_CONNECTION_HOST=redis
BULLMQ_CONNECTION_PORT=6379
BULLMQ_CONNECTION_PASSWORD=password

# Срок хранения завершённых и неудачных задач в Redis (по умолчанию 1 час / 30 дней)
# LEADS_QUEUE_COMPLETED_RETENTION_MS=3600000
# LEADS_QUEUE_FAILED_RETENTION_MS=2592000000

# Окно дедупликации задач по id лида и каналу (по умолчанию 24 часа)
# LEADS_DEDUPLICATION_TTL_MS=86400000
